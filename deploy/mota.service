[Unit]
Description=魔塔 24层 网页版 (static files + leaderboard API)
After=network.target

[Service]
Type=simple
User=mota
Group=mota
WorkingDirectory=/opt/mota
ExecStart=/opt/mota/mota-server -addr 127.0.0.1:8001 -static /opt/mota/public -data /opt/mota/data/leaderboard.json -trust-proxy
Restart=on-failure
RestartSec=3

# hardening — the process only needs to read ./public and write ./data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/mota/data
MemoryMax=64M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
